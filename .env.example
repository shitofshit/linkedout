# ─────────────────────────────────────────────────────────────
# Linkedout — local environment template
# Copy to .env.local and fill in the blanks. .env.local is gitignored.
#   PowerShell:  Copy-Item .env.example .env.local
# ─────────────────────────────────────────────────────────────

# Gemini — used by /api/generate (Phase 2c)
# Create a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model (optional — defaults to gemini-2.5-flash)
#   gemini-2.5-flash       — default, fast, supports grounding
#   gemini-2.5-flash-lite  — cheaper
#   gemini-2.5-pro         — higher quality, slower
GEMINI_MODEL=gemini-2.5-flash

# LinkedIn — used by /api/oauth/* and /api/publish (Phase 3)
# From: https://www.linkedin.com/developers/apps → your app → Auth
LINKEDIN_CLIENT_ID=86whpk2cuaj7uw
LINKEDIN_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URL" registered in the LinkedIn app
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# Random string used to sign the OAuth state param + session cookie (Phase 3)
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
